{
	"compilerOptions": {
		"module": "commonjs",
		"target": "ES2020",
		"lib": [
			"ES2020"
		],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"mocha"
		],
		"moduleResolution": "node"
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}