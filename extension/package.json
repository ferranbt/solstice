{
  "name": "solstice-language-server",
  "displayName": "Solstice",
  "description": "Solidity Language Server and Debugger",
  "license": "MIT",
  "version": "0.1.3",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "language-server",
    "Solidity",
    "ethereum",
    "foundry",
    "forge",
    "evm",
    "tracing",
    "debugging"
  ],
  "icon": "icon.png",
  "publisher": "ferranborreguero",
  "repository": {
    "url": "https://github.com/ferranbt/solstice",
    "type": "git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "bugs": {
    "url": "https://github.com/ferranbt/solstice/issues"
  },
  "enabledApiProposals": [],
  "activationEvents": [
    "onLanguage:sol"
  ],
  "main": "./out/main.js",
  "contributes": {
    "languages": [
      {
        "id": "sol",
        "extensions": [
          ".sol"
        ],
        "aliases": [
          "Solidity"
        ],
        "configuration": "./solidity.configuration.json"
      },
      {
        "id": "foundry.toml",
        "filenames": [
          "foundry.toml"
        ],
        "aliases": [
          "Foundry configuration file"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "sol"
      }
    ],
    "commands": [
      {
        "command": "sol.startDebug",
        "title": "Start Debug Session"
      },
      {
        "command": "solstice.showDependencyGraph",
        "title": "Show Dependency Graph",
        "category": "Solstice",
        "icon": "$(graph)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "solstice.showDependencyGraph",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "configuration": [
      {
        "title": "general",
        "properties": {
          "solstice.restartServerOnConfigChange": {
            "markdownDescription": "Automatically restart the language server when settings that require a restart are modified.",
            "default": false,
            "type": "boolean"
          }
        }
      },
      {
        "title": "sol-language-server",
        "properties": {
          "sol-language-server.trace.server": {
            "type": "string",
            "scope": "window",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "enumDescriptions": [
              "No traces",
              "Error only",
              "Full log"
            ],
            "default": "off",
            "description": "Traces the communication between VS Code and the language server."
          },
          "solstice.solsticePath": {
            "type": "string",
            "default": "",
            "description": "Path to the Solstice language server directory"
          }
        }
      },
      {
        "title": "Inlay Hints"
      },
      {
        "title": "Inlay Hints",
        "properties": {
          "solstice.inlayHints.closingBraceHints.enable": {
            "markdownDescription": "Display inlay hints next to closing `}` braces to show which block or construct they terminate.",
            "default": true,
            "type": "boolean"
          }
        }
      },
      {
        "title": "Inlay Hints",
        "properties": {
          "solstice.inlayHints.closingBraceHints.minLines": {
            "markdownDescription": "Required minimum line count between opening and closing braces before displaying hints (use 0 or 1 to display hints for all blocks).",
            "default": 25,
            "type": "integer",
            "minimum": 0
          }
        }
      }
    ],
    "grammars": [
      {
        "language": "sol",
        "scopeName": "source.solidity",
        "path": "./syntax/solidity.json",
        "balancedBracketScopes": [
          "*"
        ],
        "unbalancedBracketScopes": [
          "meta.scope.case-pattern.solidity"
        ]
      }
    ],
    "debuggers": [
      {
        "type": "mock",
        "languages": [
          "sol"
        ],
        "label": "Mock Debug",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              },
              "compileError": {
                "type": "string",
                "description": "Simulates a compile error in 'launch' request.",
                "enum": [
                  "default",
                  "show",
                  "hide"
                ],
                "enumDescriptions": [
                  "default: show fake compile error to user",
                  "show fake compile error to user",
                  "do not show fake compile error to user"
                ]
              }
            }
          },
          "attach": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after attach.",
                "default": true
              },
              "trace": {
                "type": "boolean",
                "description": "Enable logging of the Debug Adapter Protocol.",
                "default": true
              },
              "compileError": {
                "type": "string",
                "description": "Simulates a compile error in 'attach' request.",
                "enum": [
                  "default",
                  "show",
                  "hide"
                ],
                "enumDescriptions": [
                  "default: show fake compile error to user",
                  "show fake compile error to user",
                  "do not show fake compile error to user"
                ]
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "mock",
            "request": "launch",
            "name": "Ask for file name",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Mock Debug: Launch",
            "description": "A new configuration for 'debugging' a user selected markdown file.",
            "body": {
              "type": "mock",
              "request": "launch",
              "name": "Ask for file name",
              "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
              "stopOnEntry": true
            }
          }
        ],
        "variables": {
          "AskForProgramName": "extension.mock-debug.getProgramName"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -- --minify",
    "test-compile": "tsc -p ./",
    "compile": "tsc -b",
    "watch": "rm -rf dist && tsc -b -w",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile && npm run lint",
    "test-integration": "node ./out/test/runTest.js",
    "build": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --format=cjs --platform=node",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "devDependencies": {
    "@types/glob": "^7.2.0",
    "@types/mocha": "^8.2.3",
    "@types/node": "^24.1.0",
    "@types/vscode": "1.75.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vscode/test-electron": "^2.5.2",
    "cross-env": "^7.0.2",
    "electron-rebuild": "^1.11.0",
    "esbuild": "^0.15.5",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "glob": "^7.1.7",
    "mocha": "^8.0.1",
    "prettier": "^3.6.2",
    "typescript": "5.4.5",
    "typescript-eslint": "^8.38.0",
    "vscode-test": "^1.4.0",
    "vscode-uri": "^3.0.2",
    "webpack": "^5.82.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "semver": "^7.7.1",
    "sinon": "^21.0.0",
    "tar": "^7.4.3",
    "vscode-debugadapter": "1.45.0",
    "vscode-debugprotocol": "1.45.0",
    "vscode-languageclient": "9.0.1"
  }
}